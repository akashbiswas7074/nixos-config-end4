#!/usr/bin/env bash
# One-file launcher: on NixOS, use the system package (no shell.nix in /nix/store).
# Otherwise: run from this tree via run-nixos.sh + shell.nix.
set -euo pipefail
script="${BASH_SOURCE[0]:-}"
[[ -L "$script" ]] && script="$(readlink -f "$script")"
REPO_DIR="$(cd "$(dirname "$script")" && pwd)"
if [[ -x /run/current-system/sw/bin/dell-g-controller-launch ]]; then
  exec /run/current-system/sw/bin/dell-g-controller-launch "$@"
fi
exec "$REPO_DIR/run-nixos.sh" run
