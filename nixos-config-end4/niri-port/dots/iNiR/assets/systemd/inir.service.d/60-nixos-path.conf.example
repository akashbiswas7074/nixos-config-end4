# Copy to ~/.config/systemd/user/inir.service.d/60-nixos-path.conf (or merge into one drop-in).
#
# 1) PATH — fix "nothing works" when Quickshell children cannot run id, pgrep, wpctl.
# 2) ExecStart — if logs show "qs not found", the unit is using ~/.local/bin/inir (raw script).
#    Point at the Nix-wrapped binary (must clear ExecStart first):
#
# [Service]
# Environment=PATH=/run/wrappers/bin:/run/current-system/sw/bin:%h/.nix-profile/bin
# ExecStart=
# ExecStart=%h/.nix-profile/bin/inir run --session
# ExecStopPost=
# ExecStopPost=-%h/.nix-profile/bin/inir cleanup-orphans
[Service]
Environment=PATH=/run/wrappers/bin:/run/current-system/sw/bin:%h/.nix-profile/bin
