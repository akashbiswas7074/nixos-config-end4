Quickshell: (1) Snapshot INITIAL_ENVIRONMENT after shell.qml Env pragmas.
(2) Prepend a NixOS-friendly PATH when missing or when /run/current-system/sw/bin is
absent so QProcess and execDetached can find sh, cat, curl, python3, niri, nmcli, etc.

--- a/src/launch/launch.cpp
+++ b/src/launch/launch.cpp
@@ -155,7 +155,6 @@
 	QsPaths::instance()->linkPathDir();
 	LogManager::initFs();
 
-	Common::INITIAL_ENVIRONMENT = QProcessEnvironment::systemEnvironment();
 
 	if (!pragmas.useSystemStyle) {
 		qunsetenv("QT_STYLE_OVERRIDE");
@@ -165,6 +164,21 @@
 	for (auto [var, val]: pragmas.envOverrides.asKeyValueRange()) {
 		qputenv(var.toUtf8(), val.toUtf8());
 	}
+	// NixOS: child QProcess and execDetached use a snapshot; systemd or minimal parents may pass no PATH.
+	// Prepend standard locations so sh, cat, curl, find, etc. resolve without a full Nix user profile in PATH.
+	{
+		const QString path = qEnvironmentVariable("PATH");
+		if (path.isEmpty() || !path.contains(QStringLiteral("current-system/sw/bin"))) {
+			const QString prefix = QStringLiteral("/bin:/run/wrappers/bin:/run/current-system/sw/bin");
+			if (path.isEmpty()) {
+				qputenv("PATH", prefix.toUtf8());
+			} else {
+				qputenv("PATH", (prefix + QStringLiteral(":") + path).toUtf8());
+			}
+		}
+	}
+
+	Common::INITIAL_ENVIRONMENT = QProcessEnvironment::systemEnvironment();
 
 	// The qml engine currently refuses to cache non file (qsintercept) paths.
 
